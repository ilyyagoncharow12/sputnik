SECRET_KEY=change_me_to_any_long_random_string

# --- служебная панель: скопируй значения из своего .env, иначе вход отключён ---
ADMIN_PHONE=+70000000000
ADMIN_PASSWORD_HASH=$2b$12$put_bcrypt_hash_here
ADMIN_2FA_CODE=00000

# соль для генерации служебных URL (любая строка; смена меняет все ссылки)
SVC_SEED=change_me

# --- Web Push (уведомления, даже когда вкладка закрыта) ---
# Создать пару ключей: python -m push (или tools/gen_vapid.py). Нужен HTTPS.
# Публичный ключ — URL-safe base64 (одна строка).
VAPID_PUBLIC_KEY=put_vapid_public_key_here
# Приватный ключ — PEM одной строкой, переводы строк записаны как \n.
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nput...\n-----END PRIVATE KEY-----\n"
# Контакт для заголовков VAPID (mailto: или https:)
VAPID_CLAIM_EMAIL=admin@sputnik.local

# https для звонков и push с телефона (файлы certs/fullchain.pem, certs/privkey.pem)
USE_HTTPS=0
HTTPS_PORT=5443

# --- база: sqlite (по умолчанию, файл sputnik.db) или живой PostgreSQL ---
DB_BACKEND=sqlite
#DATABASE_URL=postgresql://sputnik:ПАРОЛЬ@127.0.0.1:5433/sputnik

# --- прод-режим (на сервере: DEBUG=0, APP_HOST=127.0.0.1, COOKIE_SECURE=1) ---
DEBUG=1
APP_HOST=0.0.0.0
APP_PORT=5000
COOKIE_SECURE=0
